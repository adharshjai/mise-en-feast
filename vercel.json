{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/index.py": { "includeFiles": "backend/**", "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!frontend/|api/).*)", "destination": "/frontend/$1" }
  ]
}
